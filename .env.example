# Copy to .env and fill in. Never commit .env.
# KEY=value lines with no quotes: docker compose and systemd both read it.
# Without Docker (docs/DEPLOY_VPS.md), drop POSTGRES_PASSWORD, GUNICORN_WORKERS
# and WEB_PORT, and set DATABASE_URL.

# Required. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Required for docker compose: the Postgres password (any long random string)
POSTGRES_PASSWORD=

# Without docker compose, point at the database yourself:
# DATABASE_URL=postgresql://user:password@host:5432/welfare
# DATABASE_URL=sqlite:////home/tgk/projects/welfare-3/instance/welfare.db

# Google Sheets: paste the service account key's JSON on one line, or mount
# the key file and give its path (see docker-compose.yml)
GOOGLE_CREDENTIALS_JSON=
# GOOGLE_CREDENTIALS_PATH=/app/credentials/service_account.json

# How many proxies (nginx, a load balancer) sit in front of the app.
# 1 for the usual nginx on the same machine; 0 if the app is reached directly.
TRUSTED_PROXIES=1

# Only for a short trial before the site has HTTPS: lets sign-in work over
# plain http://. Passwords can then be read on the network. Remove it after.
# ALLOW_HTTP=1

# Gunicorn worker processes (about 2 per CPU core)
GUNICORN_WORKERS=2

# Where docker compose publishes the app (default: only this machine, for nginx)
# WEB_PORT=127.0.0.1:8000

# Optional
# CLEANUP_TIME=02:00
# REPORT_RETENTION_DAYS=7
# SUPPORT_SESSION_MINUTES=60
# LOGIN_RATE_LIMIT=10 per minute;50 per hour
# PUBLIC_LOOKUP_RATE_LIMIT=10 per minute;30 per hour
